<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AniPub</title>

    <link rel="stylesheet" href="/home.css">
    <link rel="stylesheet" href="/third-section.css">
    <link rel="stylesheet" href="/home-main.css">
    <link rel="stylesheet" href="/footer.css">

</head>

<body > <!--onload="CheckAuth();"-->

    <header class="header-div" >
        <a href="/" target="_blank" class="first-section-a">
            <div class="first-section">
                <div class="logo-div" >
                    <img class="logo" src="Logo-1.png" alt="">
                </div>
                <div class="details">
                    <p class="name">AniPub</p>
                    <p class="slogan" style="margin-left: 1px; margin-top: -2px;">Yamate Kudasai</p>
                </div>
            </div>
        </a>
        <div class="Search-Box-Area">
            <input class="searchbox" type="text" placeholder="Search">
            <button class="search-button"></button>
           
        </div>

        <div class="Second-Section">
            <button class="random">Random</button>

            <% if(auth === true) { %> 
            <button data-account="<%=ID%> " class="profile-icon" title="Profile Menu">
             <img style="width: 100%; height: 100%;  object-position: center;" src="account_circle_24dp_000000_FILL0_wght400_GRAD0_opsz24.svg" alt="">
            </button>
            <% } else {%>
                <button data-account="<%=ID%>" class="profile-icon" title="Profile Menu">
                    <img style="width: 100%; height: 100%;  object-position: center;" src="account_circle_24dp_000000_FILL0_wght400_GRAD0_opsz24.svg" alt="">
                   </button>
            <% } %>     
        </div>
    </header>

    <div class="secoNd-Section">

        <div class="aniLists">
            <% Anime.forEach(value => {%>
                <div class="Profile-div">
                    <div class="Profile" data-anime="<%=value[0].id%>">
                    <div class="Image-div">
                        <img class="poster" src="<%=value[0].poster%>" alt="<%=value[0].Name%> Anime Poster">
                    </div>
                    <div class="Title-div"><p class="Title"><%=value[0].Name%></p></div>
                    <div class="ratings-div">
                        <p class="mal-score"><%=value[0].MALScore%></p>
                        <img src="rating-<%=value[0].RatingsNum%>.png" alt="Rating Star Image">
                    </div>
                    <div class="des-div">
                        <p class="des">
                        <%=value[0].DescripTion%>
                        </p>
                    </div>
                </div>
                </div>
           <% }); %> 
        </div>
   

    
        
    
    
    
    </div>


    <footer>
       
        
    
    </footer>
   
<!--
    <script type="module" src="animeInfo.js"></script>
     <script type="module" src="/Home.js"></script>
-->
    <script src="home.js"></script>
    <script type="module" src="/ANiPlayer-render.js"></script>

</body>
</html>